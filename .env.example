# Copy this file to .env and fill in the values for whichever provider you're using.
# Only one provider needs credentials — LLM_PROVIDER picks which.

# openai is the default; anthropic and ollama still work.
LLM_PROVIDER=openai

# --- anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- openai (default) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- ollama (free, local, no key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# 0 (deterministic-leaning) to 1. See README for why this reduces variation without making a
# hosted model bit-for-bit deterministic.
LLM_TEMPERATURE=0

# --- privacy / logging ---
# Off by default: question/answer text is never stored unless you opt in here. Metrics (timings,
# refusal reason, citation counts) are always logged regardless of this setting.
LOG_RAW_CONTENT=false
# Independent of LOG_RAW_CONTENT, also off by default. Captures the model's raw pre-validation
# output — what it generated before a refusal replaced it with the canned phrase and discarded any
# citations it wrote. This CAN echo your question and can contain a hallucinated citation or a
# hedge that was never shown to you; it exists to diagnose a refusal without re-running the live
# API, not for routine use. A cache hit never calls the model, so nothing is captured on a hit
# regardless of this setting.
LOG_RAW_MODEL_OUTPUT=false
# Persistent response caching is independently opt-in. When enabled, validated answer text may be
# stored locally for this bounded TTL; disabling it does not erase legacy rows. Use the explicit
# `python -m src.cache --scrub-content --dry-run` / `--scrub-content` commands to inspect/remove
# recognised cache rows. The cache key is a hash; this is not an anonymity guarantee.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=86400
# Days a logged row is kept before `python -m src.obslog --purge-expired` deletes it.
LOG_RETENTION_DAYS=30
# Optional. When set, logged rows carry an HMAC-SHA256 of the question (pseudonymous, not
# anonymous) instead of nothing, so repeat questions are still detectable without recovering the
# question text. Leave blank to store no fingerprint at all.
LOG_HASH_KEY=

# --- deployment boundary ---
# This stack has no authentication. Do not expose it beyond localhost. Comma-separated list of
# origins the API will accept browser requests from — defaults to the local chat UI only.
CORS_ALLOWED_ORIGINS=http://localhost:8501
