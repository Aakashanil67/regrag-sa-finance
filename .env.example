# Copy this file to .env and fill in the values for whichever provider you're using.
# Only one provider needs credentials — LLM_PROVIDER picks which.

# anthropic | openai | ollama
LLM_PROVIDER=anthropic

# --- anthropic (default) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- openai (alternative) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ollama (free, local, no key) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
