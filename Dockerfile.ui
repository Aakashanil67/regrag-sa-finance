FROM python:3.12-slim

WORKDIR /app

# No torch, no Chroma, no sentence-transformers, no Anthropic SDK: neither UI process runs a model
# or touches the vector store directly — chat.py and ops.py both talk to the API over HTTP only
# (see app/ops.py's module docstring for why that boundary matters). requirements-ui.txt is
# Streamlit/httpx/pandas only.
COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt

COPY src/ ./src/
COPY app/ ./app/

EXPOSE 8501

CMD ["streamlit", "run", "app/chat.py", "--server.address=0.0.0.0", "--server.port=8501"]
