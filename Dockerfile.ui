FROM python:3.12-slim

WORKDIR /app

# Same CPU-only torch install as Dockerfile.api, for the same reason — see the comment there.
# Neither UI process runs a model (chat.py talks to the API over HTTP, ops.py reads the SQLite log
# and the report files), but both install the full requirements.txt, so without this they'd carry
# the same ~3.4GB of unusable CUDA libraries the API image did.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY app/ ./app/

EXPOSE 8501

CMD ["streamlit", "run", "app/chat.py", "--server.address=0.0.0.0", "--server.port=8501"]
